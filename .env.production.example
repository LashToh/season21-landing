# =============================================================================
# PRODUCTION — Frontend (Vite build-time variables)
# =============================================================================
# Copy to .env.production before `npm run build`.
# Vite embeds VITE_* values at build time — they cannot be changed after build
# without rebuilding the site.

# Public URL of your Node.js registration API (must be reachable from browsers)
# Must NOT have a trailing slash. Example: https://api.tudominio.com
VITE_API_URL=https://api.tudominio.com

VITE_DOWNLOAD_URL=https://tu-cdn.example.com/MU-Client.zip
VITE_DISCORD_URL=https://discord.gg/SV6yW7XK7
VITE_INSTAGRAM_URL=https://www.instagram.com/mubredaonline/
VITE_FACEBOOK_URL=https://www.facebook.com/mubredaonline

# =============================================================================
# PRODUCTION — Backend API (Node.js server runtime variables)
# =============================================================================
# Copy these to `.env` on the machine running `npm run server` (or `npm start`).
# The React build does NOT include DB credentials — they live only on the API host.

DB_SERVER=YOUR_SQL_SERVER_IP
DB_PORT=1433
DB_NAME=MuOnline
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_ENCRYPT=false
DB_TRUST_CERT=true

# cPanel Node.js sets PORT automatically — API_PORT is fallback for local dev
API_PORT=3001

# Must match your live site origin exactly (scheme + domain, no trailing slash)
# Example: https://tudominio.com
CORS_ORIGIN=https://tudominio.com

# Password hash for MEMB_INFO.memb__pwd — must match JoinServer / MuDevs setup
# Options: plain | md5 (default, recommended) | wz_md5
HASH_METHOD=md5

DEFAULT_SNO_NUMB=1111111111111
INSERT_VI_CURR_INFO=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
