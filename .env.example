# =============================================================================
# LOCAL DEVELOPMENT — copy to `.env` and fill in your SQL Server credentials
# =============================================================================
# Backend API connects to MuDevs Season 21 SQL Server and inserts into MEMB_INFO.
# Frontend (Vite) calls POST /api/register on the API — no mock registration.

# --- SQL Server (required for real account creation) ---
DB_SERVER=YOUR_IP_HERE
DB_PORT=1433
DB_NAME=MuOnline
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- API server ---
API_PORT=3001
# cPanel Node.js sets PORT automatically — API_PORT is fallback for local dev
# Browser origin allowed to call the API (must match your Vite dev URL)
CORS_ORIGIN=http://localhost:5173

# Password hash for MEMB_INFO.memb__pwd — must match JoinServer / MuDevs setup
# Método de hash para memb__pwd — debe coincidir con JoinServer / MuDevs
# Recommended default for MuDevs Season 21 web registration (32-char MD5 hex)
# Valor recomendado para registro web MuDevs Season 21 (MD5 hex de 32 caracteres)
# Options / Opciones: plain | md5 (default) | wz_md5
HASH_METHOD=md5

# Optional registration defaults (WebEngine-compatible)
# DEFAULT_SNO_NUMB matches WebEngine default serial: 1111111111111
# INSERT_VI_CURR_INFO=false for Season 21 (WebEngine season_1_support=false)
DEFAULT_SNO_NUMB=1111111111111
INSERT_VI_CURR_INFO=false

# Rate limiting (5 requests per 15 minutes by default)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# --- Frontend (Vite) — also readable from .env.local ---
# URL where `npm run server` listens; used by Register modal fetch()
VITE_API_URL=http://localhost:3001
VITE_DOWNLOAD_URL=https://your-cdn.example.com/MU-Client.zip
VITE_DISCORD_URL=https://discord.gg/SV6yW7XK7
VITE_INSTAGRAM_URL=https://www.instagram.com/mubredaonline/
VITE_FACEBOOK_URL=https://www.facebook.com/mubredaonline
